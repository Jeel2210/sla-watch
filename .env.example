# Neon PostgreSQL connection string
# Format: postgres://[user[:password]@][netloc][:port][/dbname]
DATABASE_URL=postgres://user:password@localhost:5432/sla_watch

# CORS allowed origin (typically the Vercel URL)
ALLOWED_ORIGIN=https://example.vercel.app

# AWS region (for SAM deployment)
AWS_REGION=us-east-1
